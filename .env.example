SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-spotify-client-secret

# Use the Raspberry Pi's LAN address and the public host port from compose.yaml.
SPOTIFY_REDIRECT_URI=http://192.168.1.50:3000/auth/callback

# Optional: changes the host port without changing the container port.
GATEWAY_PORT=3000
